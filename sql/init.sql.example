-- ----------------------------
-- Table structure for chat_summary
-- ----------------------------
DROP TABLE IF EXISTS `chat_summary`;
CREATE TABLE `chat_summary`  (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `session_id` bigint NOT NULL,
  `summary` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL,
  `last_summarized_message_id` bigint NULL DEFAULT NULL,
  `update_time` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`) USING BTREE,
  UNIQUE INDEX `session_id`(`session_id` ASC) USING BTREE,
  INDEX `idx_session_id`(`session_id` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 7 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci ROW_FORMAT = Dynamic;

-- ----------------------------
-- Records of chat_summary
-- ----------------------------
INSERT INTO `chat_summary` VALUES (1, 5, '**用户需求**：生成一个简单的计算器 Java 代码。\n\n**关键信息**：\n1.  **控制台版**：利用 `Scanner` 接收输入，支持加、减、乘、除四则运算，包含除零校验和输入异常处理。\n2.  **GUI 图形版**：基于 `Swing` 库开发，使用 `FlowLayout` 布局，包含输入框、运算按钮和结果显示框，同样包含除零和非数字输入的错误处理。\n3.  **运行指南**：助手说明了如何保存文件、使用 `javac` 编译及 `java` 运行。\n\n**结论**：用户对提供的代码表示满意，助手提出了后续优化建议，包括扩展功能（如取余、幂运算）、优化布局（改用网格布局）以及增强异常处理。', NULL, '2026-04-15 11:31:17');
INSERT INTO `chat_summary` VALUES (2, 8, '**用户需求**：用户请求编写一段 Java 代码，但未指定具体功能。\n\n**关键信息**：由于请求宽泛，助手提供了三个不同场景的 Java 代码示例：\n1.  **Hello World**：演示基本的程序结构和控制台输出。\n2.  **交互式计算器**：演示用户输入（Scanner）和逻辑处理，包含四则运算、除数非零检查及资源管理（try-finally）。\n3.  **学生类**：演示面向对象特性，包含类的定义、构造方法、成员方法及封装。\n\n**结论**：助手提示用户，若有具体需求（如文件操作、多线程等），可提供更精准的代码。', NULL, '2026-04-27 14:02:55');
INSERT INTO `chat_summary` VALUES (3, 19, '**用户需求：** 分析当前AI行业趋势。\n\n**关键信息：**\n1.  **技术演进：**\n    *   **多模态：** 从纯文本向原生多模态（文本、音频、视觉实时处理）发展。\n    *   **端侧AI：** 重视小语言模型（SLMs）及端侧部署，以降低成本、保护隐私。\n    *   **智能体（Agent）：** AI从“对话者”向具备规划和执行能力的“执行者”转变。\n    *   **效率优化：** 重点关注推理速度提升与成本降低。\n2.  **应用与商业化：**\n    *   **垂直应用：** 针对医疗、法律等特定领域的垂直模型兴起。\n    *   **生成式搜索：** AI直接生成答案，重塑信息获取方式。\n    *   **编程辅助：** AI编程工具普及，提升开发效率。\n    *   **内容创作：** 视频、3D生成及数字人技术应用广泛。\n3.  **产业格局：** 算力与生态被云厂商和巨头垄断，开源模型能力快速逼近闭源，竞争激烈。\n4.  **挑战与风险：** 面临高质量数据枯竭、版权纠纷、安全对齐问题（如Deepfake、幻觉）以及全球监管合规压力。\n\n**结论：**\n当前AI行业核心关键词为**“落地”**与**“多模态”**，正处于从“技术爆发”向“产业落地”转型的务实阶段。创业者应聚焦应用层与垂直领域创新，个人用户需尽快掌握AI工具以融入工作流，避免被替代。', NULL, '2026-04-28 10:25:26');
INSERT INTO `chat_summary` VALUES (4, 22, '## 对话摘要\n\n**用户需求**：\n1. 寻找午餐建议\n2. 了解成都美食推荐\n3. 询问川西旅游景点\n4. 查询四川民族大学附近游玩场所\n5. 确认对话内容回顾\n\n**关键信息**：\n- **午餐建议**：提供了中式、快捷和健康轻盈三类选择，建议包含优质蛋白质、复合碳水和蔬菜\n- **成都美食**：推荐火锅、串串香、担担面等特色小吃，以及锦里古街、宽窄巷子等美食街区\n- **川西游玩**：推荐九寨沟、稻城亚丁等自然风光，色达佛学院等人文景观，最佳旅游时间为5-10月，注意高原反应\n- **四川民族大学周边**：大渡河观景步道、姑咱镇藏式生活区、校园文化体验，以及康定城区(跑马山/木格措)、塔公草原等短途景点，并提供交通、高海拔适应等实用贴士\n\n**结论**：助手针对用户连续提出的多个旅游和餐饮需求提供了详细建议，涵盖了美食推荐、景点介绍和实用贴士，并在最后确认并总结了对话内容。', NULL, '2026-04-28 10:54:14');
INSERT INTO `chat_summary` VALUES (5, 30, '**用户需求：** 用户连续三次询问当前时间\n\n**关键信息：**\n- 用户三次重复询问时间信息\n- 系统时间显示：23:01:03 → 23:01:20 → 23:14:18（2026年5月9日）\n- 时间在查询过程中动态变化（13秒内增加约13秒）\n- 每次查询均通过get_current_time函数获取\n\n**已确认约束：**\n- 需要多次获取实时时间信息\n- 时间数据具有动态性\n\n**阶段性结论：**\n- 当前时间约为2026年5月9日23:14\n- 系统能够准确提供实时时间查询服务\n- assistant对每次时间查询都给予及时响应和友好提醒', 72, '2026-05-09 23:14:25');
INSERT INTO `chat_summary` VALUES (6, 37, '对话摘要：\n- 用户需求：用户仅进行了简单的问候，未明确提出具体需求\n- 关键信息：用户连续三次说\"你好\"，表示开始对话但尚未提出问题\n- 已确认约束：无特殊约束被确认\n- 阶段性结论：助手已做好服务准备，正在等待用户提出具体问题或需求', 100, '2026-05-14 17:55:41');

-- ----------------------------
-- Table structure for model_config
-- ----------------------------
DROP TABLE IF EXISTS `model_config`;
CREATE TABLE `model_config`  (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `model_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  `api_key` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL,
  `endpoint` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL,
  `status` int NULL DEFAULT 1,
  `supports_vision` tinyint(1) NULL DEFAULT 0,
  `create_time` datetime NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 6 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci ROW_FORMAT = Dynamic;

