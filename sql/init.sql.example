INSERT INTO `chat_attachment` VALUES (1, NULL, NULL, NULL, 'session', NULL, '类图.md', 'D:\\桌面\\spring boot\\Agent\\uploads\\7216fff2-79a3-4c71-aa16-47068a86da52.md', 6159, 'text/markdown', '# 工厂方法模式 - 数据格式转换工具类图（Mermaid）\n\n## 1. 设计说明\n\n本设计基于工厂方法模式，实现了一个数据格式转换工具，支持将TXT文件、SQL文件、Excel表格转换为XML格式。\n\n### 核心角色\n- **抽象产品（Product）**：`DataConverter` - 定义统一的转换接口\n- **具体产品（ConcreteProduct）**：`TXTDataConverter`、`SQLDataConverter`、`ExcelDataConverter` - 实现具体转换逻辑\n- **抽象工厂（Factory）**：`DataConverterFactory` - 定义创建转换器的工厂方法\n- **具体工厂（ConcreteFactory）**：`TXTDataConverterFactory`、`SQLDataConverterFactory`、`ExcelDataConverterFactory` - 创建对应转换器\n\n## 2. 类图\n\n```mermaid\nclassDiagram\n    direction LR\n    \n    class DataConverter {\n        + convertToXml(dataSource: String): String\n    }\n    \n    class TXTDataConverter {\n        - filePath: String\n        + readDataFromPath(filePath: String): StringBuilder\n        + formatXml(content: StringBuilder, fileName: String, readTime: String): String\n        + convertToXml(dataSource: String): String\n    }\n    \n    class SQLDataConverter {\n        - createTablePattern: Pattern\n        - insertPattern: Pattern\n        - columnPattern: Pattern\n        + readSqlFile(filePath: String): String\n        + parseCreateStatements(sqlContent: String): Map\n        + parseInsertStatements(sqlContent: String): Map\n        + formatXml(fileName: String, tableColumns: Map, tableData: Map, parseTime: String): String\n        + convertToXml(dataSource: String): String\n    }\n    \n    class ExcelDataConverter {\n        + readExcelFile(excelPath: String): List<Map>\n        + getCellValue(cell: Cell): String\n        + formatXml(excelPath: String, data: List<Map>, readTime: String): String\n        + convertToXml(dataSource: String): String\n    }\n    \n    class DataConverterFactory {\n        + createConverter(): DataConverter\n    }\n    \n    class TXTDataConverterFactory {\n        + createConverter(): DataConverter\n    }\n    \n    class SQLDataConverterFactory {\n        + createConverter(): DataConverter\n    }\n    \n    class ExcelDataConverterFactory {\n        + createConverter(): DataConverter\n    }\n    \n    class Client {\n        + main(args: String[]): void\n    }\n    \n    TXTDataConverter --> DataConverter\n    SQLDataConverter --> DataConverter\n    ExcelDataConverter --> DataConverter\n    \n    TXTDataConverterFactory --> DataConverterFactory\n    SQLDataConverterFactory --> DataConverterFactory\n    ExcelDataConverterFactory --> DataConverterFactory\n    \n    TXTDataConverterFactory ..> TXTDataConverter: creates\n    SQLDataConverterFactory ..> SQLDataConverter: creates\n    ExcelDataConverterFactory ..> ExcelDataConverter: creates\n    \n    Client ..> DataConverterFactory: uses\n    Client ..> DataConverter: uses\n```\n\n## 3. 类图说明\n\n### 3.1 抽象产品（DataConverter）\n- **角色**：抽象产品\n- **职责**：定义所有数据转换器的统一接口\n- **方法**：`convertToXml(String dataSource)` - 将指定数据源转换为XML格式\n\n### 3.2 具体产品\n\n#### TXTDataConverter\n- **角色**：具体产品\n- **职责**：读取TXT文件并转换为XML\n- **核心方法**：\n  - `readDataFromPath()` - 读取TXT文件内容\n  - `formatXml()` - 格式化XML结构\n  - `convertToXml()` - 实现抽象方法\n\n#### SQLDataConverter\n- **角色**：具体产品\n- **职责**：解析SQL文件并转换为XML\n- **核心方法**：\n  - `readSqlFile()` - 读取SQL文件内容\n  - `parseCreateStatements()` - 解析CREATE TABLE语句\n  - `parseInsertStatements()` - 解析INSERT语句\n  - `formatXml()` - 格式化XML结构\n  - `convertToXml()` - 实现抽象方法\n\n#### ExcelDataConverter\n- **角色**：具体产品\n- **职责**：读取Excel文件并转换为XML\n- **核心方法**：\n  - `readExcelFile()` - 读取Excel文件内容\n  - `getCellValue()` - 获取单元格值\n  - `formatXml()` - 格式化XML结构\n  - `convertToXml()` - 实现抽象方法\n\n### 3.3 抽象工厂（DataConverterFactory）\n- **角色**：抽象工厂\n- **职责**：定义创建转换器的工厂方法\n- **方法**：`createConverter()` - 返回DataConverter类型\n\n### 3.4 具体工厂\n\n#### TXTDataConverterFactory\n- **角色**：具体工厂\n- **职责**：创建TXTDataConverter实例\n- **方法**：`createConverter()` - 返回TXTDataConverter实例\n\n#### SQLDataConverterFactory\n- **角色**：具体工厂\n- **职责**：创建SQLDataConverter实例\n- **方法**：`createConverter()` - 返回SQLDataConverter实例\n\n#### ExcelDataConverterFactory\n- **角色**：具体工厂\n- **职责**：创建ExcelDataConverter实例\n- **方法**：`createConverter()` - 返回ExcelDataConverter实例\n\n### 3.5 客户端（Client）\n- **角色**：客户端\n- **职责**：通过工厂获取转换器并使用\n- **方法**：`main()` - 演示工具使用\n\n## 4. 设计特点\n\n1. **严格遵循工厂方法模式**：完整实现四大核心角色\n2. **符合开闭原则**：新增数据源只需新增具体产品和具体工厂\n3. **对象创建与使用分离**：客户端通过工厂获取对象，不直接new\n4. **职责分离**：工厂负责创建，产品负责业务逻辑\n5. **面向接口编程**：客户端仅依赖抽象接口\n\n## 5. 扩展性\n\n如需新增数据源（如CSV文件），只需：\n1. 新增 `CSVDataConverter` 实现 `DataConverter` 接口\n2. 新增 `CSVDataConverterFactory` 实现 `DataConverterFactory` 接口\n3. 客户端代码无需任何修改\n\n## 6. 对应关系\n\n| 工厂方法模式角色 | 对应实现类 | 核心职责 |\n|----------------|------------|----------|\n| 抽象产品 | DataConverter | 定义统一转换接口 |\n| 具体产品 | TXTDataConverter | TXT转XML |\n| 具体产品 | SQLDataConverter | SQL转XML |\n| 具体产品 | ExcelDataConverter | Excel转XML |\n| 抽象工厂 | DataConverterFactory | 定义创建工厂方法 |\n| 具体工厂 | TXTDataConverterFactory | 创建TXT转换器 |\n| 具体工厂 | SQLDataConverterFactory | 创建SQL转换器 |\n| 具体工厂 | ExcelDataConverterFactory | 创建Excel转换器 |\n| 客户端 | FactoryMethodClient | 使用工厂获取并使用转换器 |\n\n', '2026-05-07 09:36:40');
INSERT INTO `chat_attachment` VALUES (2, 25, NULL, NULL, 'session', NULL, '类图.md', 'D:\\桌面\\spring boot\\Agent\\uploads\\8a85668c-52a0-4606-8f50-92b155e060de.md', 6159, 'text/markdown', '# 工厂方法模式 - 数据格式转换工具类图（Mermaid）\n\n## 1. 设计说明\n\n本设计基于工厂方法模式，实现了一个数据格式转换工具，支持将TXT文件、SQL文件、Excel表格转换为XML格式。\n\n### 核心角色\n- **抽象产品（Product）**：`DataConverter` - 定义统一的转换接口\n- **具体产品（ConcreteProduct）**：`TXTDataConverter`、`SQLDataConverter`、`ExcelDataConverter` - 实现具体转换逻辑\n- **抽象工厂（Factory）**：`DataConverterFactory` - 定义创建转换器的工厂方法\n- **具体工厂（ConcreteFactory）**：`TXTDataConverterFactory`、`SQLDataConverterFactory`、`ExcelDataConverterFactory` - 创建对应转换器\n\n## 2. 类图\n\n```mermaid\nclassDiagram\n    direction LR\n    \n    class\n...[文档内容已保存至知识库，可直接提问]', '2026-05-07 12:02:35');
INSERT INTO `chat_attachment` VALUES (3, 25, NULL, NULL, 'session', NULL, '面试问题与答案.md', 'D:\\桌面\\spring boot\\Agent\\uploads\\174d252f-00b0-455e-b812-99335769ccc1.md', 5217, 'text/markdown', '# 技术社区平台 - 面试问题与答案\n\n---\n\n## 1. 前端错误处理逻辑减少约 60% 是怎么算的？\n\n**答案**：这是基于代码行数统计的。改造前，前端 30+ 个接口调用处都要写独立的错误处理代码（try-catch、判断不同错误格式等），总计约 90 行。改造后，统一使用全局 axios 拦截器处理 `ResVo` 格式的响应，只需约 15 行代码。减少比例 = (90-15)/90 ≈ 83%，保守写 60% 是考虑到部分特殊场景仍需单独处理。\n\n**验证方法**：统计改造前后的前端错误处理代码行数，对比差异。\n\n---\n\n## 2. 本地缓存命中率达 85% 以上是怎么测的？\n\n**答案**：Caffeine 缓存开启了 `recordStats()` 统计功能，通过 `CacheStats` API 获取命中率。具体步骤：\n1. 在 `ForumCoreAutoConfig` 中启用 `recordStats()`\n2. 开发了 `CaffeineStatsCollector` 工具类，每 30 秒打印一次缓存统计\n3. 本地压测热门文章场景，观察日志中的 `命中率`\n...[文档内容已保存至知识库，可直接提问]', '2026-05-08 16:36:44');
