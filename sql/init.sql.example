INSERT INTO `chat_message` VALUES (102, 41, 'assistant', '用户说了“你好”，这是一个问候。\n用户提示词未提供具体的“上下文”或“知识库”。\n当前的指令是“知识问答”。\n要求如下：\n1. 优先直接回答，再解释。\n2. 基于检索证据（目前没有）。\n3. 表达简洁、清晰。\n\n由于这只是问候，我不需要检索任何内容。我应该以友好且专业的方式回应，介绍我自己作为AI助手的角色。\n\n起草回复：\n- 确认问候。\n- 说明我是AI助手。\n- 询问我能如何提供帮助。\n\n针对“知识问答”模式进行优化：\n- “你好！我是智能AI助手。请问有什么问题需要我帮你解答吗？”（你好！我是智能AI助手。你有什么问题需要我帮你回答吗？）\n\n这符合简洁和清晰的要求。你好！我是智能AI助手。请问有什么问题需要我帮你解答吗？', '2026-05-14 18:02:01', NULL, NULL, NULL);
