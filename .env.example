# ============================================
# AI Chat 平台 — Docker Compose 环境变量
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================

# MySQL root 密码
MYSQL_PASSWORD=change-me-mysql

# Redis 密码
REDIS_PASSWORD=change-me-redis

# JWT 签名密钥 (至少 32 字符的随机字符串)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# 智谱 API Key (GLM 系列模型使用)
ZHIPU_API_KEY=your-zhipu-api-key

# API Key 加密密钥 (必须恰好 32 字节, 用于 AES-256-GCM)
# 生成方式: openssl rand -base64 32
APP_API_KEY_SECRET=change-me-to-32-bytes-random-key!!

# CORS 允许的来源 (前端访问地址)
CORS_ORIGINS=http://localhost:82
